{
  "name": "sponsor-not-sponsor",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "assets": "node scripts/release-assets.mjs",
    "package": "node scripts/package.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "screenshots": "node scripts/store-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/browser-embedded.mjs && node scripts/browser-overview.mjs && node scripts/browser-cross-origin.mjs",
    "test:browser:embedded": "node scripts/browser-embedded.mjs",
    "test:popup": "node scripts/popup-sizing.mjs",
    "research:serve": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "decision:serve": "node --env-file-if-exists=.env --import tsx server/decision-server.ts",
    "decision:download": "node --env-file-if-exists=.env scripts/download-decision.mjs",
    "evaluate:decision": "node --env-file-if-exists=.env --import tsx scripts/evaluate-decision.ts",
    "test:decision:browser": "node --import tsx scripts/browser-decision.ts",
    "evaluate": "tsx evaluation/evaluate.ts",
    "evaluate:regression": "tsx evaluation/evaluate.ts --holdout",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
