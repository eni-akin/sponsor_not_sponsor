# Copy to .env for local development.
# Only the local research server loads this file; never bundle it in the extension.
APP_ENV=development
# Optional: broader official-source discovery through Brave Search.
BRAVE_SEARCH_API_KEY=
# Exact employer identities and verified official source mappings.
RESEARCH_EMPLOYERS_FILE=server/employers.json
RESEARCH_CACHE_DIR=.research-cache
# Optional override; defaults to the unpacked extension ID derived from dist/.
RESEARCH_EXTENSION_ID=
