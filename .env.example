# Local services load this file when it exists; never bundle .env in the extension.
# Company-research settings below are deferred.
# Optional: broader official-source discovery through Brave Search.
BRAVE_SEARCH_API_KEY=
# Deferred company-research backend settings.
RESEARCH_EMPLOYERS_FILE=server/employers.json
RESEARCH_CACHE_DIR=.research-cache
# Deferred company-research extension setting.
RESEARCH_EXTENSION_ID=
# Local Laya decision service (separate from company research).
DECISION_PYTHON=.decision-venv/bin/python
DECISION_EXTENSION_ID=
LAYA_MODEL=convaiinnovations/laya-multilingual
LAYA_REVISION=
LAYA_DEVICE=cpu
LAYA_THREADS=4
